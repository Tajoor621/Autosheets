{
  "id": "/Autosheets/",
  "name": "AutoSheets",
  "short_name": "AutoSheets",
  "description": "Ultimate Fleet, Rental, Parking & Taxi Business & Accounting Application. Offline-first multi-currency management for car rental, parking and taxi fleet operators.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#090D16",
  "theme_color": "#090D16",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "assets/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open the executive dashboard",
      "url": "./index.html",
      "icons": [
        {
          "src": "assets/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Quick Rental",
      "short_name": "Rental",
      "description": "Create a new rental agreement",
      "url": "./index.html#rental",
      "icons": [
        {
          "src": "assets/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Log Parking",
      "short_name": "Parking",
      "description": "Issue a parking ticket",
      "url": "./index.html#parking",
      "icons": [
        {
          "src": "assets/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dispatch Taxi",
      "short_name": "Taxi",
      "description": "Record and settle a taxi fare",
      "url": "./index.html#taxi",
      "icons": [
        {
          "src": "assets/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [".json"]
      },
      "icons": [
        {
          "src": "assets/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "note_taking": {
    "new_note_url": "./index.html"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+autosheets",
      "url": "./index.html?data=%s"
    }
  ]
}
